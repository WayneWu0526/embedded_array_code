!data/README.md
!data/**/
!data/**/.gitkeep
!data/**/README.md
src/sensor_data_collection/data/
src/sensor_data_collection/data_backup/
src/sensor_data_collection/result*/
src/sensor_data_collection/plot/**
!src/sensor_data_collection/plot/
!src/sensor_data_collection/plot/*.py

# Keep source/config JSON files trackable even though result JSON is ignored.
!src/**/config/**/*.json

# Git worktrees
.worktrees/
