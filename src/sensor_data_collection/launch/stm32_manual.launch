<launch>
  <!-- STM32 Manual Calibration Capture for MagGrad firmware -->
  <!-- 仅启动 STM32 新固件串口节点和手动平均记录节点 -->
  <!--
    手动采集功能：
    - 触发话题: /maggrad_manual_record/record_trigger (std_msgs/Bool)
    - True  = 开始录制（创建新 CSV 文件 manual_record_{timestamp}.csv）
    - False = 停止录制并关闭文件
    - 数据源: stm_uplink_raw (raw 数据：ADU/bit -> Gs + R_CORR 方位统一，未做 calibration)
    - 输出: $(arg output_dir)/manual_record_*.csv
    - 格式: CSV (sensor_1_x,sensor_1_y,sensor_1_z,...,sensor_12_z)
    - 平均: 每 frames_to_average 条消息平均后写入一行

    参数:
    - output_dir: CSV 输出目录
    - frames_to_average: 每行平均的帧数（默认 10）
    - startup_strategy: 新固件启动模式，默认 cont，会发送 MODE CONT

    使用示例:
      # 开始录制
      rostopic pub /maggrad_manual_record/record_trigger std_msgs/Bool "data: true" -1
      # 停止录制
      rostopic pub /maggrad_manual_record/record_trigger std_msgs/Bool "data: false" -1
  -->

  <!-- Arguments -->
  <arg name="port" default="auto"/>
  <arg name="baudrate" default="115200"/>
  <arg name="profile" default="maggrad_dual_v1"/>
  <arg name="array_config" default="qmc6309_12ch_v1"/>
  <arg name="imu_config" default="icm42670"/>
  <arg name="n_sensors" default="12"/>
  <arg name="output_dir" default="$(find sensor_data_collection)/../../data/manual_calibration"/>
  <arg name="frames_to_average" default="10"/>
  <arg name="startup_strategy" default="cont"/>
  <arg name="startup_sensors" default="auto"/>
  <arg name="trigger_rate_hz" default="100"/>
  <arg name="input_topic" default="stm_uplink_raw"/>

  <!-- STM32 MagGrad firmware serial node -->
  <node name="serial_node_maggrad" pkg="serial_processor" type="serial_node_maggrad.py" output="screen">
    <param name="port" value="$(arg port)"/>
    <param name="baudrate" value="$(arg baudrate)"/>
    <param name="profile" value="$(arg profile)"/>
    <param name="array_config" value="$(arg array_config)"/>
    <param name="imu_config" value="$(arg imu_config)"/>
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="startup_strategy" value="$(arg startup_strategy)"/>
    <param name="startup_sensors" value="$(arg startup_sensors)"/>
    <param name="trigger_rate_hz" value="$(arg trigger_rate_hz)"/>
  </node>

  <!-- Manual affine-calibration CSV recorder.
       Keeps the old manual_record_*.csv column format expected by calibration scripts. -->
  <node name="maggrad_manual_record" pkg="sensor_data_collection"
        type="maggrad_manual_record_node.py" output="screen">
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="frames_to_average" value="$(arg frames_to_average)"/>
    <param name="n_sensors" value="$(arg n_sensors)"/>
    <param name="input_topic" value="$(arg input_topic)"/>
  </node>

</launch>
